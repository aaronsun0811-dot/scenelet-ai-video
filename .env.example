# Scenelet Generator Environment Configuration
# Scenelet 生成器环境配置
#
# Copy this file to .env and fill in your values.
# 将此文件复制为 .env 并填入你的配置值。
#
# Most settings (API keys, backend selection, rate limits, model choices, etc.)
# have been moved to the WebUI settings page (/settings). Configure them there after first launch.
# 大部分配置（API Key、后端选择、速率限制、模型选择等）
# 已迁移至 WebUI 配置页（/settings），首次启动后通过页面配置即可。
#
# This file only contains startup-level / infrastructure settings.
# 此文件仅保留启动级/基础设施配置。

# ============================================================
# Authentication / 认证配置
# ============================================================
# Login username (default: admin)
# 登录用户名（默认: admin）
AUTH_USERNAME=admin
# Login password (leave empty to auto-generate on first launch and write back to this file)
# 登录密码（留空则首次启动时自动生成并回写到此文件）
AUTH_PASSWORD=
# JWT signing secret (leave empty to auto-generate; tokens will invalidate on restart)
# JWT 签名密钥（留空则自动生成，但重启后 token 失效需重新登录）
AUTH_TOKEN_SECRET=
# Optional SaaS-style DB user accounts. Enabled automatically when registration is open.
# 可选：启用数据库账号体系。开放注册时会自动启用。
# AUTH_DB_USERS=1
# Public registration switch. Set to 0 for private local installs.
# 注册开关。私人本地部署如需关闭注册，可设为 0。
AUTH_ALLOW_REGISTRATION=1

# ============================================================
# Database Configuration / 数据库配置
# ============================================================
# Default: SQLite (for development / single-machine deployment)
# 默认使用 SQLite（开发/单机）
# SQLite:     sqlite+aiosqlite:///./projects/.scenelet.db
# PostgreSQL: postgresql+asyncpg://scenelet:pass@host:5432/scenelet
# Existing projects/.arcreel.db installs are still detected automatically.
# DATABASE_URL=sqlite+aiosqlite:///./projects/.scenelet.db

# ============================================================
# Logging / 日志配置
# ============================================================
# Log level (default: INFO, options: DEBUG, WARNING, ERROR)
# 日志级别（默认: INFO，可选: DEBUG, WARNING, ERROR）
# LOG_LEVEL=INFO

# ============================================================
# Stripe Billing / Stripe 支付配置
# ============================================================
# Secret key from Stripe Dashboard
# Stripe 后台的 Secret key
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from Stripe CLI or Dashboard endpoint
# Stripe CLI 或后台 Webhook Endpoint 的签名密钥
# STRIPE_WEBHOOK_SECRET=whsec_...
# Public frontend base URL used by Checkout success/cancel redirects
# Checkout 支付完成/取消后返回的前端地址
# STRIPE_FRONTEND_BASE_URL=http://localhost:5173
# Optional explicit redirect URLs. Leave empty to use /app/projects defaults.
# 可选：显式指定支付完成/取消跳转地址。留空则使用默认项目页。
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=
# Optional package override JSON:
# [{"id":"starter","credits":1000,"currency":"USD","price_minor":990}]
# PLATFORM_CREDIT_PACKAGES_JSON=
# Local-only sandbox helpers: enables admin "simulate paid" for pending credit orders.
# 本地联调用：允许管理员把待支付积分订单模拟确认为已支付。生产环境不要开启。
# BILLING_SANDBOX_TOOLS=0

# ============================================================
# Video Provider / 视频供应商
# ============================================================
# Global default video provider (gemini | seedance)
# 全局默认视频供应商 (gemini | seedance)
# DEFAULT_VIDEO_PROVIDER=gemini

# ============================================================
# Seedance (Volcengine Ark) / Seedance (火山方舟) 配置
# ============================================================
# Volcengine Ark API key / 火山方舟 API key
# ARK_API_KEY=
# Public URL of the project file service (Seedance image upload requires public access)
# 项目文件服务公网地址（Seedance 图片上传需要公网访问）
# FILE_SERVICE_BASE_URL=
